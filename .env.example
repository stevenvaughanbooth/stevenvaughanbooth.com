# Ask Steven (server-only). Set these in Vercel > Project > Settings > Environment Variables.
# Mark ANTHROPIC_API_KEY as "Sensitive" so it is write-only after creation. Never prefix with NEXT_PUBLIC_.
# Use a key from a dedicated Anthropic Console workspace with a low monthly spend limit.
ANTHROPIC_API_KEY=

# Added automatically by the Upstash Redis integration from the Vercel Marketplace.
# UPSTASH_REDIS_REST_URL / UPSTASH_REDIS_REST_TOKEN are accepted as alternatives.
# Without Redis, live answers stay off (limits fail closed) and the palette uses curated answers.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Optional. Unset, "true", "1" or "on" = on; any other value (e.g. "false") turns live answers off.
# Instant off switch without a redeploy: `SET ask:disabled 1` in the Upstash console (`DEL` to re-enable).
ASK_ENABLED=
